# AWS credentials the console uses to drive the agentcore CLI, AWS CLI and CloudWatch.
# The console reads these from the environment (see console/server.mjs).
AWS_PROFILE=my-profile
AWS_DEFAULT_REGION=us-west-2

# (Optional) Port for the console orchestrator. Defaults to 4000.
PORT=4000

# (Optional) SSM SecureString parameter holding the GitHub PAT used for real
# "export to GitHub" repo creation. Defaults to /openclaw/github/melanie531-pat.
GITHUB_PAT_SSM=/openclaw/github/melanie531-pat

# (Optional) SHOW_SIM=1 reveals the demo-only lifecycle "advance" buttons on the
# export tracker and the fleet agent detail. They stand in for real-world triggers
# the demo has no wiring for (a commit landing, CI finishing, a deploy), so they
# are HIDDEN by default — the lifecycle stepper still renders, read-only.
# Unset/anything else = hidden. The /api/lifecycle-advance API stays available
# either way (the e2e suite drives lifecycle stages through it).
# SHOW_SIM=1

# Demo Cognito config (for the per-user identity flow) is NOT set here — it lives
# in .demo-secrets/cognito.env (gitignored). See the README "Identity" section.
